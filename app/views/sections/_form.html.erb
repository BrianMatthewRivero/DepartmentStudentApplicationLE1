<%= form_with(model: section, local: true) do |f| %>
  <div>
    <%= f.label :name, "Section Name (e.g. BSIT-3A)" %><br>
    <%= f.text_field :name %>
  </div>

  <br>

<div>
  <%= f.label :subject_id, "Subject" %><br>
  <%= f.collection_select :subject_id, Subject.all, :id, :subject_name, prompt: "Select a Subject" %>
</div>

  <br>

  <div>
    <%= f.label :room, "Room / Laboratory" %><br>
    <%= f.text_field :room %>
  </div>

  <br>

  <div>
    <%= f.label :timeslot, "Timeslot (e.g. MWF 10:00 AM - 11:30 AM)" %><br>
    <%= f.text_field :timeslot %>
  </div>

  <br>

  <%= f.submit %>
<% end %>