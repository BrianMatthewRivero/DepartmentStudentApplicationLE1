<%= form_with(model: classlist, local: true) do |f| %>
  <% if classlist.errors.any? %>
    <div style="color: red; margin-bottom: 15px;">
      <h2><%= pluralize(classlist.errors.count, "error") %> prohibited this enrollment from being saved:</h2>
      <ul>
        <% classlist.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div style="margin-bottom: 15px;">
    <%= f.label :student_id, "Select Student" %><br>
    <%= f.collection_select :student_id, Student.all, :id, :name, { prompt: "Choose a Student..." }, { required: true } %>
  </div>

<div style="margin-bottom: 15px;">
  <%= f.label :section_id, "Select Section" %><br>
  <%= f.collection_select :section_id, Section.includes(:subject).all, :id, ->(s) { "#{s.name} - #{s.subject&.subject_name}" }, { prompt: "Choose a Section..." }, { required: true } %>
</div>

  <div>
    <%= f.submit "Save Enrollment" %>
  </div>
<% end %>