<p style="color: green"><%= notice %></p>

<h1>All Enrollments (Classlists)</h1>

<%= link_to "Enroll a Student", new_classlist_path %>
<br><br>

<table border="1" cellpadding="8" style="border-collapse: collapse; width: 100%;">
  <thead>
    <tr style="background-color: #f2f2f2;">
      <th>Student Name</th>
      <th>Program & Year</th>
      <th>Section</th>
      <th>Subject</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @classlists.each do |classlist| %>
      <tr>
        <td><%= classlist.student&.name %></td>
        <td><%= classlist.student&.program %> - <%= classlist.student&.year_level %></td>
        <td><%= classlist.section&.name %></td>
        <td><%= classlist.section&.subject&.subject_name %></td>
        <td>
          <%= button_to "Unenroll", classlist_path(classlist), method: :delete, data: { turbo_confirm: "Are you sure you want to remove this enrollment?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>