  <h1><%= @subject.subject_name %> (<%= @subject.code %>)</h1>

  <p>
    <strong>Assigned Instructor:</strong> <%= @subject.teacher&.name %>
  </p>

  <hr>

  <% if @subject.sections.any? %>
  <% @subject.sections.each do |section| %>
    <h3><%= section.name %></h3>
    <table>
      <thead>
        <tr>
          <td colspan="5">
            Room: <%= section.room %> |
            Timeslot: <%= section.timeslot %> |
            Teacher: <%= section.subject.teacher.name %>
          </td>
        </tr>
        <th align="left"> Name </th>
        <th align="left"> Year Level </th>
        <th align="left"> Program </th>
      </thead>
      <tbody>
          <% section.students.each do |student| %>
          <tr>
            <td><%= student.name %></td>
            <td><%= student.year_level %></td>
            <td><%= student.program %></td>  
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
  <% else %>
  <p>No sections found for this subject.</p>
<% end %>

  <br>
  <div>
    <%= link_to "Edit Subject", edit_subject_path(@subject) %> |
    <%= link_to "Back to Subjects", subjects_path %>
  </div>